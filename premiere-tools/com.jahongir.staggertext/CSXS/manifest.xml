<?xml version="1.0" encoding="UTF-8"?>
<!-- Stagger Text — tanlangan kliplarga fade-up animatsiya qo'yadigan panel.
     CEP 11 · Premiere Pro 24.0 va undan yangi. -->
<ExtensionManifest Version="11.0"
    ExtensionBundleId="com.jahongir.staggertext"
    ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="Stagger Text"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.jahongir.staggertext.panel" Version="1.0.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[24.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.jahongir.staggertext.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Stagger Text</Menu>
          <Geometry>
            <Size>
              <Width>320</Width>
              <Height>400</Height>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
