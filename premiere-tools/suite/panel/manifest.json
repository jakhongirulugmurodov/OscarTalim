{
  "id": "uz.oscartalim.podcastsuite",
  "name": "Podcast Suite",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.0"
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "http://127.0.0.1:8765",
        "http://127.0.0.1:8765/",
        "http://localhost:8765",
        "http://localhost:8765/"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "podcastsuite.panel",
      "label": { "default": "Podcast Suite" },
      "minimumSize": { "width": 380, "height": 420 },
      "preferredDockedSize": { "width": 420, "height": 560 },
      "preferredFloatingSize": { "width": 420, "height": 560 }
    }
  ]
}
